@startuml Use_Case_Sprint3
' Sprint 3 — Espace admin, analytics, audit

left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #FAFAFA
  BorderColor #455A64
}

title Diagramme de cas d'utilisation — Sprint 3\n(Administration, analytics, audit)

actor "Admin\n(back-office)" as Admin
actor "Client\n(boutique)" as Client

rectangle "Authentification" #E8EAF6 {
  usecase "Se connecter (admin)" as UC_AdminLogin
}

rectangle "Pilotage & reporting" #ECEFF1 {
  usecase "Tableau de bord analytics" as UC_Dashboard
  usecase "Exporter KPI (CSV)" as UC_ExportCsv
}

rectangle "Gestion catalogue" #E8F5F1 {
  usecase "CRUD produits" as UC_AdminProducts
  usecase "CRUD catégories" as UC_AdminCategories
  usecase "Ajuster stock produit" as UC_AdminStock
}

rectangle "Promotions (admin)" #FCE4EC {
  usecase "Gérer règles cadeau" as UC_AdminGiftRules
  usecase "Créer cadeau catalogue" as UC_AdminGifts
}

rectangle "Commandes & clients" #FFF8E1 {
  usecase "Lister / filtrer commandes" as UC_AdminOrders
  usecase "Consulter détail commande" as UC_AdminOrderDetail
  usecase "Confirmer paiement\n(admin)" as UC_AdminConfirmPay
  usecase "Annuler commande\n(admin)" as UC_AdminCancel
  usecase "Consulter clients" as UC_AdminCustomers
  usecase "Historique commandes\npar client" as UC_CustomerOrders
}

rectangle "Sécurité & traçabilité" #CFD8DC {
  usecase "Consulter journal d'audit" as UC_AuditLog
}

' --- Liens admin (toutes routes JWT Admin) ---
Admin --> UC_AdminLogin
Admin --> UC_Dashboard
Admin --> UC_ExportCsv
Admin --> UC_AdminProducts
Admin --> UC_AdminCategories
Admin --> UC_AdminStock
Admin --> UC_AdminGiftRules
Admin --> UC_AdminGifts
Admin --> UC_AdminOrders
Admin --> UC_AdminOrderDetail
Admin --> UC_AdminConfirmPay
Admin --> UC_AdminCancel
Admin --> UC_AdminCustomers
Admin --> UC_CustomerOrders
Admin --> UC_AuditLog

' --- Alternative client (hors périmètre admin pur) ---
Client --> UC_AdminConfirmPay
note on link
  Alternative :
  POST /api/me/orders/{id}/pay
end note

UC_Dashboard ..> UC_AdminLogin : <<include>>
UC_ExportCsv ..> UC_Dashboard : <<extend>>
UC_AdminProducts ..> UC_AdminLogin : <<include>>
UC_AdminCategories ..> UC_AdminLogin : <<include>>
UC_AdminStock ..> UC_AdminProducts : <<extend>>
UC_AdminGiftRules ..> UC_AdminLogin : <<include>>
UC_AdminGifts ..> UC_AdminLogin : <<include>>
UC_AdminOrders ..> UC_AdminLogin : <<include>>
UC_AdminOrderDetail ..> UC_AdminOrders : <<extend>>
UC_AdminConfirmPay ..> UC_AdminLogin : <<include>>
UC_AdminCancel ..> UC_AdminLogin : <<include>>
UC_AdminCustomers ..> UC_AdminLogin : <<include>>
UC_CustomerOrders ..> UC_AdminCustomers : <<extend>>
UC_AuditLog ..> UC_AdminLogin : <<include>>

note right of UC_Dashboard
  KPI : CA, nombre commandes, AOV,
  top ventes, stock bas,
  clients fidèles / forte valeur.
  CA hors Pending / Cancelled.
end note

note bottom of UC_AdminOrders
  **Évolution S3+**
  Filtres (statut, client, dates)
  synchronisés avec l'URL Angular.
end note

note bottom of Admin
  JWT rôle **Admin**
  /api/admin/* · /api/analytics/*
  Liste clients : admin uniquement
  (plus d'exposition publique).
end note

@enduml
