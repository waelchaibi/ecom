@startuml Sequence_02_Payment_Gifts
' Séquence : paiement simulé → Confirmed → attribution des cadeaux

title Séquence 2 — Paiement simulé et attribution des cadeaux

actor "Client\n(Angular)" as UI
actor "Admin\n(Angular)" as AdminUI
participant "MeController\n/api/me/orders/{id}/pay" as MeCtrl
participant "AdminOrdersController\nconfirm-payment" as AdminCtrl
participant "OrderService" as OrderSvc
participant "GiftAssignmentService" as GiftEngine
participant "GiftRuleFactory" as RuleFactory
participant "GiftRepository" as GiftRepo
database "PostgreSQL\n(EF Core)" as DB

alt Entrée client [JWT Customer]
  UI -> MeCtrl : POST /api/me/orders/{id}/pay
  activate MeCtrl
  MeCtrl -> OrderSvc : PayOrderAsCustomerAsync(customerId, orderId)
  note right of MeCtrl : vérifie propriété
else Entrée admin [JWT Admin]
  AdminUI -> AdminCtrl : POST /api/admin/orders/{id}/confirm-payment
  activate AdminCtrl
  AdminCtrl -> OrderSvc : ConfirmPaymentAsync(orderId)
end

activate OrderSvc
OrderSvc -> DB : BEGIN TRANSACTION
OrderSvc -> DB : SELECT Order + OrderItems + Customer

alt Status != Pending
  OrderSvc --> MeCtrl : 409 InvalidOperationException
  OrderSvc --> AdminCtrl : 409
else Status == Pending (ou déjà Confirmed → idempotent)

  OrderSvc -> DB : COUNT commandes passées\n(Confirmed/Shipped, hors commande courante)

  OrderSvc -> GiftEngine : EvaluateAsync(GiftRuleEvaluationContext)
  activate GiftEngine
  GiftEngine -> DB : SELECT GiftRules actives\n(ORDER BY Priority DESC)

  loop pour chaque GiftRule active
    GiftEngine -> RuleFactory : CreateRule(ruleType)
    RuleFactory --> GiftEngine : IGiftRule
    GiftEngine -> GiftEngine : IsSatisfied(context)
    opt règle satisfaite
      GiftEngine -> GiftEngine : ajouter GiftRuleApplication
    end
  end

  GiftEngine --> OrderSvc : IReadOnlyList<GiftRuleApplication>
  deactivate GiftEngine

  loop pour chaque cadeau à attribuer
    OrderSvc -> GiftRepo : TryDecrementStockAsync(giftId, 1)
    GiftRepo -> DB : UPDATE Gifts (stock -= 1)
    opt stock suffisant
      OrderSvc -> DB : INSERT OrderGift
    end
  end

  OrderSvc -> DB : UPDATE Order SET Status = Confirmed
  OrderSvc -> DB : COMMIT
  OrderSvc -> DB : SELECT Order (rechargé + OrderGifts)
  OrderSvc --> MeCtrl : OrderDTO
  OrderSvc --> AdminCtrl : OrderDTO
end

deactivate OrderSvc
MeCtrl --> UI : 200 OrderDTO + AssignedGifts
deactivate MeCtrl
AdminCtrl --> AdminUI : 200 OrderDTO
deactivate AdminCtrl

note over UI, DB
  Cadeaux évalués **uniquement** à la confirmation.
  Règles : Amount (total), Loyalty (historique), Promotion (code).
end note

@enduml
