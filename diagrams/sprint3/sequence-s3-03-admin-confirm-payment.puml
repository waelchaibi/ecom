@startuml Sequence_S3_03_Admin_Confirm_Payment
' US-S3-03 : Admin confirme paiement Pending → Confirmed + cadeaux

title US-S3-03 — Confirmation paiement par l'admin

actor "Admin\n(Angular)" as AdminUI
participant "AdminOrdersController\nconfirm-payment" as AdminCtrl
participant "OrderService" as OrderSvc
participant "GiftAssignmentService" as GiftEngine
participant "AuditService" as Audit
database "PostgreSQL\n(EF Core)" as DB

AdminUI -> AdminCtrl : POST /api/admin/orders/{id}/confirm-payment\n[JWT Admin]
activate AdminCtrl
AdminCtrl -> OrderSvc : ConfirmPaymentAsync(orderId)
activate OrderSvc

OrderSvc -> DB : SELECT Order + Items + Customer

alt Status != Pending
  OrderSvc --> AdminCtrl : 409 InvalidOperationException
  AdminCtrl --> AdminUI : erreur
else Pending (ou idempotent si déjà Confirmed)

  OrderSvc -> DB : BEGIN TRANSACTION
  OrderSvc -> DB : COUNT historique fidélité

  OrderSvc -> GiftEngine : EvaluateAsync(context)
  activate GiftEngine
  GiftEngine -> DB : SELECT GiftRules actives
  GiftEngine --> OrderSvc : applications[]
  deactivate GiftEngine

  loop cadeaux applicables
    OrderSvc -> DB : UPDATE Gifts stock -= 1
    OrderSvc -> DB : INSERT OrderGift
  end

  OrderSvc -> DB : UPDATE Order Status = Confirmed
  OrderSvc -> DB : COMMIT
  OrderSvc -> DB : SELECT Order (rechargé)
  OrderSvc --> AdminCtrl : OrderDTO + AssignedGifts
end

deactivate OrderSvc

AdminCtrl -> Audit : LogAsync(admin, ConfirmPayment, Order, id)
activate Audit
Audit -> DB : INSERT AuditLog
deactivate Audit

AdminCtrl --> AdminUI : 200 commande confirmée
deactivate AdminCtrl

note over AdminUI, OrderSvc
  Alternative client :
  POST /api/me/orders/{id}/pay
  (même logique métier OrderService).
end note

@enduml
