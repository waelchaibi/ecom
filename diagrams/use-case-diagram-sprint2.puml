@startuml Use_Case_Sprint2
' Sprint 2 — Cadeaux promotionnels (moteur de règles)

left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #FAFAFA
  BorderColor #455A64
}

title Diagramme de cas d'utilisation — Sprint 2\n(Cadeaux promotionnels & règles métier)

actor "Client\n(boutique)" as Client
actor "Admin\n(back-office)" as Admin
actor "Système\n(moteur règles)" as System

rectangle "Côté boutique" #FCE4EC {
  usecase "Saisir code promo\nau checkout" as UC_PromoCode
  usecase "Passer commande\n(Pending)" as UC_Checkout
  usecase "Payer commande\n(simulé)" as UC_PayClient
  usecase "Recevoir cadeaux\nautomatiques" as UC_ReceiveGifts
  usecase "Consulter cadeaux\nsur commande" as UC_ViewGifts
  usecase "Consulter catalogue\ncadeaux (public)" as UC_ListGifts
}

rectangle "Configuration (admin)" #FFECB3 {
  usecase "Se connecter (admin)" as UC_AdminLogin
  usecase "Créer / modifier\ncadeau catalogue" as UC_ManageGifts
  usecase "Configurer règle cadeau\n(Amount / Loyalty / Promotion)" as UC_ManageRules
  usecase "Activer / désactiver\nrègle" as UC_ToggleRule
}

Client --> UC_PromoCode
Client --> UC_Checkout
Client --> UC_PayClient
Client --> UC_ViewGifts
Client --> UC_ListGifts

Admin --> UC_ManageGifts
Admin --> UC_ManageRules
Admin --> UC_ToggleRule

System --> UC_ReceiveGifts

UC_PromoCode ..> UC_Checkout : <<extend>>
UC_PayClient ..> UC_Checkout : <<include>>
UC_ReceiveGifts ..> UC_PayClient : <<extend>>
UC_ViewGifts ..> UC_ReceiveGifts : <<extend>>
UC_ManageRules ..> UC_AdminLogin : <<include>>
UC_ManageGifts ..> UC_AdminLogin : <<include>>
UC_ToggleRule ..> UC_ManageRules : <<extend>>

note right of UC_ReceiveGifts
  **GiftAssignmentService**
  Règles : montant commande,
  fidélité (historique confirmé),
  code promo (ex. SPRINT2).
  Déduplication + priorité.
end note

note bottom of UC_PayClient
  Brief Sprint 2 initial : cadeaux
  à la **création** de commande.
  **Code actuel** : attribution au
  paiement (Pending → Confirmed).
end note

note left of UC_ListGifts
  Sprint 2 historique :
  GET /api/gifts (public).
  Gestion complète via admin (S3).
end note

@enduml
