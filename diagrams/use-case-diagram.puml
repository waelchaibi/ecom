@startuml Ecommerce_Use_Case_Diagram
' Diagramme de cas d'utilisation — plateforme e-commerce (Sprints 1–3 + évolutions)
' Acteurs : Client (boutique), Admin (back-office), Système (règles métier / stock)

left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #FAFAFA
  BorderColor #455A64
}

title Diagramme de cas d'utilisation — E-commerce Shayma

actor "Client\n(boutique)" as Client
actor "Admin\n(back-office)" as Admin
actor "Système\n(moteur règles)" as System

rectangle "Sprint 1 — Catalogue, panier, commandes" #E8F5F1 {
  usecase "Parcourir le catalogue\n(filtres URL)" as UC_Browse
  usecase "Consulter détail produit" as UC_ProductDetail
  usecase "S'inscrire" as UC_Register
  usecase "Se connecter (client)" as UC_CustomerLogin
  usecase "Consulter mon profil" as UC_Profile
  usecase "Gérer le panier" as UC_Cart
  usecase "Passer commande\n(checkout → Pending)" as UC_Checkout
  usecase "Consulter mes commandes" as UC_MyOrders
  usecase "Annuler commande Pending" as UC_CancelPending
}

rectangle "Sprint 2 — Cadeaux promotionnels" #FCE4EC {
  usecase "Saisir code promo\nau checkout" as UC_PromoCode
  usecase "Payer commande\n(simulé client)" as UC_PayClient
  usecase "Recevoir cadeaux\nautomatiques" as UC_ReceiveGifts
  usecase "Consulter cadeaux\nsur commande" as UC_ViewGifts
  usecase "Gérer catalogue cadeaux" as UC_ManageGifts
  usecase "Configurer règles cadeau" as UC_ManageRules
}

rectangle "Sprint 3 — Admin & analytics" #ECEFF1 {
  usecase "Se connecter (admin)" as UC_AdminLogin
  usecase "Tableau de bord analytics" as UC_Dashboard
  usecase "Exporter KPI (CSV)" as UC_ExportCsv
  usecase "CRUD produits / catégories" as UC_AdminProducts
  usecase "Lister / filtrer commandes" as UC_AdminOrders
  usecase "Confirmer paiement\n(admin)" as UC_AdminConfirmPay
  usecase "Annuler commande\n(admin)" as UC_AdminCancel
  usecase "Consulter clients\n+ historique" as UC_AdminCustomers
  usecase "Consulter journal d'audit" as UC_AuditLog
}

' --- Acteur Client ---
Client --> UC_Browse
Client --> UC_ProductDetail
Client --> UC_Register
Client --> UC_CustomerLogin
Client --> UC_Cart
Client --> UC_Checkout
Client --> UC_MyOrders
Client --> UC_CancelPending
Client --> UC_PromoCode
Client --> UC_PayClient
Client --> UC_ViewGifts

' --- Acteur Admin ---
Admin --> UC_AdminLogin
Admin --> UC_Dashboard
Admin --> UC_ExportCsv
Admin --> UC_AdminProducts
Admin --> UC_ManageGifts
Admin --> UC_ManageRules
Admin --> UC_AdminOrders
Admin --> UC_AdminConfirmPay
Admin --> UC_AdminCancel
Admin --> UC_AdminCustomers
Admin --> UC_AuditLog

' --- Système (automatique) ---
System --> UC_ReceiveGifts

' --- Include / Extend ---
UC_Checkout ..> UC_CustomerLogin : <<include>>
UC_Checkout ..> UC_Cart : <<include>>
UC_PromoCode ..> UC_Checkout : <<extend>>
UC_Profile ..> UC_CustomerLogin : <<include>>
UC_MyOrders ..> UC_CustomerLogin : <<include>>
UC_PayClient ..> UC_CustomerLogin : <<include>>
UC_CancelPending ..> UC_CustomerLogin : <<include>>
UC_ReceiveGifts ..> UC_PayClient : <<extend>>
UC_ReceiveGifts ..> UC_AdminConfirmPay : <<extend>>
UC_ViewGifts ..> UC_ReceiveGifts : <<extend>>
UC_Dashboard ..> UC_AdminLogin : <<include>>
UC_ExportCsv ..> UC_Dashboard : <<extend>>
UC_AdminOrders ..> UC_AdminLogin : <<include>>
UC_AdminConfirmPay ..> UC_AdminLogin : <<include>>
UC_ManageRules ..> UC_AdminLogin : <<include>>

note right of UC_ReceiveGifts
  Évaluation **GiftAssignmentService**
  à la confirmation (Pending → Confirmed).
  Brief S2 initial : à la création ;
  **code actuel** : au paiement.
end note

note bottom of Admin
  JWT rôle Admin — routes /api/admin/*
  et /api/analytics/*
end note

@enduml
