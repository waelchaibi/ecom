@startuml Sequence_S2_03_Gifts_On_Payment
' US-S2-03 : Paiement simulé → cadeaux attribués (moteur de règles)

title US-S2-03 — Attribution des cadeaux au paiement

actor "Client\n(Angular)" as UI
participant "MeController\nPOST .../pay" as MeCtrl
participant "OrderService" as OrderSvc
participant "GiftAssignmentService" as GiftEngine
participant "GiftRuleFactory" as RuleFactory
participant "GiftRepository" as GiftRepo
database "PostgreSQL\n(EF Core)" as DB

UI -> MeCtrl : POST /api/me/orders/{id}/pay\n[JWT Customer]
activate MeCtrl
MeCtrl -> OrderSvc : PayOrderAsCustomerAsync(customerId, orderId)
activate OrderSvc

OrderSvc -> DB : SELECT Order + Items + Customer
alt pas propriétaire ou Status != Pending
  OrderSvc --> MeCtrl : 404 / 409
  MeCtrl --> UI : erreur
else Pending

  OrderSvc -> DB : BEGIN TRANSACTION
  OrderSvc -> DB : COUNT commandes passées\n(Confirmed/Shipped, hors courante)

  OrderSvc -> GiftEngine : EvaluateAsync(context)\n(total, loyalty count, promotionCode)
  activate GiftEngine
  GiftEngine -> DB : SELECT GiftRules actives\nORDER BY Priority DESC

  loop chaque règle active
    GiftEngine -> RuleFactory : CreateRule(ruleType)
    RuleFactory --> GiftEngine : IGiftRule\n(Amount / Loyalty / Promotion)
    GiftEngine -> GiftEngine : IsSatisfied(context)
    opt satisfaite + pas doublon giftId
      GiftEngine -> GiftEngine : ajouter application
    end
  end

  GiftEngine --> OrderSvc : GiftRuleApplication[]
  deactivate GiftEngine

  loop chaque cadeau retenu
    OrderSvc -> GiftRepo : TryDecrementStockAsync(giftId, 1)
    GiftRepo -> DB : UPDATE Gifts stock
    opt stock OK
      OrderSvc -> DB : INSERT OrderGift
    end
  end

  OrderSvc -> DB : UPDATE Order Status = Confirmed
  OrderSvc -> DB : COMMIT
  OrderSvc -> DB : SELECT Order + OrderGifts
  OrderSvc --> MeCtrl : OrderDTO + AssignedGifts
end

deactivate OrderSvc
MeCtrl --> UI : 200\n"You received a promotional gift"
deactivate MeCtrl

note over GiftEngine
  **Promotion** : PromotionCode sur Order
  (ex. SPRINT2, insensible casse)
  **Amount** : TotalAmount > seuil
  **Loyalty** : historique commandes confirmées
end note

@enduml
